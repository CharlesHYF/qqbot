{
  "name": "qqbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "node scripts/build-wiki.mjs && tsc --noEmit",
    "lint": "node scripts/build-wiki.mjs && eslint .",
    "format": "prettier --write .",
    "test": "node scripts/build-wiki.mjs && vitest run",
    "build:wiki": "node scripts/build-wiki.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "packageManager": "pnpm@11.10.0"
}
